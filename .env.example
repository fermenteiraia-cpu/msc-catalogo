# MSC-Catalogo — variáveis de ambiente (template versionado)
#
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env (já está no .gitignore).

# === Terasoft API ===
# Credenciais com o David
TERASOFT_USER=
TERASOFT_PASS=
TERASOFT_URL=https://apiserver.ip.inf.br:12067/consulta

# === OpenAI API (gpt-image-2 para render IA) ===
# Console: https://platform.openai.com/api-keys
# Hard cap: $50/mês (definir no console também)
OPENAI_API_KEY=

# === Anthropic API (Claude Sonnet 4.5 — briefer IA) ===
# Console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# === Supabase (Postgres + Auth + Storage + Realtime) ===
# Criar projeto em https://supabase.com (free tier suficiente para MVP)
# Region: South America (São Paulo)
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
