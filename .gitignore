# Environment / secrets — NEVER commit
.env
.env.local
.env.*.local
*.env
!.env.example

# MCP config contains tokens — NEVER commit
.mcp.json

# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# App caches and outputs (regenerable)
app/cache/
campanhas/

# Reference assets that don't belong in repo
_ref_pdf/

# Node / Next (covered also by studio/.gitignore)
node_modules/
.next/
out/
*.tsbuildinfo
.vercel/

# IDE / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# BMAD output is generated artifacts; configurable
# uncomment if you don't want to version planning artifacts
# _bmad-output/
